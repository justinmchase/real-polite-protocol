{
  "unstable": ["kv"],
  "imports": {
    "@justinmchase/grove": "jsr:@justinmchase/grove@1.0.2",
    "@cliffy/command": "jsr:@cliffy/command@^1.1.1",
    "@justinmchase/serializable": "jsr:@justinmchase/serializable@^0.3.15",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.10/hex",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@std/path/glob-to-regexp": "jsr:@std/path@^1.1.5/glob-to-regexp",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "@std/uuid": "jsr:@std/uuid@^1.1.1",
    "@std/yaml": "jsr:@std/yaml@^1.1.1",
    "zod": "npm:zod@^4.4.3"
  },
  "tasks": {
    "start": "deno run -A main.ts",
    "dev": "RPP_DEV_MODE=1 deno run -A main.ts",
    "dev:remote": "RPP_DEV_MODE=1 RPP_KV_TUNNEL=1 deno run -A --tunnel main.ts",
    "as": "deno run -A scripts/dev/test-user.ts",
    "notify": "deno run -A scripts/notify-watcher.ts",
    "migrate": "deno run -A scripts/migrate.ts",
    "migrate:remote": "RPP_KV_TUNNEL=1 deno run -A --tunnel scripts/migrate.ts",
    "test": "deno test -A --ignore=src/scenarios src/",
    "scenarios": "deno test -A src/scenarios/",
    "check": "deno fmt && deno lint && deno task test && deno task scenarios"
  },
  "deploy": {
    "org": "justinmchase",
    "app": "real-polite-protocol"
  }
}

